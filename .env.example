# postgres-mcp environment example
#
# Copy to .env and edit for your environment:
#   cp .env.example .env
#
# Do not commit real database URLs, OAuth secrets, private keys, or Valkey
# credentials.

# =============================================================================
# Local Docker Compose defaults
# =============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres_mcp
POSTGRES_PORT=5432

POSTGRES_MCP_PORT=8000
POSTGRES_MCP_ACCESS_MODE=restricted
POSTGRES_MCP_TRANSPORT=streamable-http

# =============================================================================
# Database configuration
#
# Choose DATABASE_URI for one connection OR DATABASE_CONNECTIONS for named static
# connections. In DATABASE_CONNECTIONS mode, each connection's mode is
# authoritative and all authenticated MCP users can access all configured
# connections.
# =============================================================================

DATABASE_URI=postgresql://postgres:postgres@localhost:5432/postgres_mcp

# DATABASE_CONNECTIONS={"connections":{"main":{"uri":"postgresql://postgres:postgres@postgres-main:5432/main_db","mode":"restricted"},"analytics":{"uri":"postgresql://postgres:postgres@postgres-analytics:5432/analytics_db","mode":"unrestricted"}},"default_connection":"main","connection_selection":"strict"}

# =============================================================================
# Streamable HTTP / OAuth 2.1 / JWT audit authentication
#
# Auth is used for audit identity only. It does not authorize or restrict which
# configured database connections a caller may use.
#
# These settings apply to HTTP transports, e.g.:
#   postgres-mcp --transport=streamable-http --streamable-http-host=0.0.0.0
# =============================================================================

MCP_ENABLE_OAUTH21=false

# Public URL used in OAuth metadata and redirects. Use POSTGRES_MCP_EXTERNAL_URL
# behind ingress/reverse proxy; it overrides POSTGRES_MCP_BASE_URL.
# POSTGRES_MCP_BASE_URL=http://localhost:8000
# POSTGRES_MCP_EXTERNAL_URL=https://postgres-mcp.example.com

# -----------------------------------------------------------------------------
# Mode A: humans only, interactive Google OAuth
# -----------------------------------------------------------------------------
# MCP_ENABLE_OAUTH21=true
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
#
# Defaults to openid + userinfo.email so audit logs can show the user's email.
# Only add scopes your Google OAuth consent screen is configured to grant.
# GOOGLE_OAUTH_SCOPES=openid,https://www.googleapis.com/auth/userinfo.email

# -----------------------------------------------------------------------------
# Mode B: machines only, bearer JWT/JWKS validation
# -----------------------------------------------------------------------------
# MCP_ENABLE_OAUTH21=true
# EXTERNAL_OAUTH21_PROVIDER=true
# FASTMCP_SERVER_AUTH_JWT_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
# FASTMCP_SERVER_AUTH_JWT_ISSUER=https://accounts.google.com
# FASTMCP_SERVER_AUTH_JWT_AUDIENCE=postgres-mcp-bots
#
# Alternative to JWKS URI. Set exactly one of PUBLIC_KEY or JWKS_URI.
# FASTMCP_SERVER_AUTH_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...
#
# Multiple machine issuers on one endpoint. When set, this takes precedence over
# the single-issuer FASTMCP_SERVER_AUTH_JWT_* variables above.
# MCP_JWT_ISSUERS=[{"name":"eks-prod","jwks_uri":"https://oidc.eks.eu-west-3.amazonaws.com/id/PROD/keys","issuer":"https://oidc.eks.eu-west-3.amazonaws.com/id/PROD","audience":"postgres-mcp-bots"},{"name":"google-wif","jwks_uri":"https://www.googleapis.com/oauth2/v3/certs","issuer":"https://accounts.google.com","audience":"postgres-mcp-bots"}]

# -----------------------------------------------------------------------------
# Mode C: unified humans + machines on one endpoint
# -----------------------------------------------------------------------------
# MCP_ENABLE_OAUTH21=true
# MCP_UNIFIED_AUTH=true
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# FASTMCP_SERVER_AUTH_JWT_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
# FASTMCP_SERVER_AUTH_JWT_ISSUER=https://accounts.google.com
# FASTMCP_SERVER_AUTH_JWT_AUDIENCE=postgres-mcp-bots

# =============================================================================
# OAuth proxy storage
#
# Use Valkey/Redis in production so OAuth client/token state survives restarts
# and can be shared by several replicas. Disk and Valkey storage are encrypted.
# The encryption key is derived from FASTMCP_SERVER_AUTH_GOOGLE_JWT_SIGNING_KEY
# when set, otherwise from GOOGLE_OAUTH_CLIENT_SECRET.
# =============================================================================

# POSTGRES_MCP_OAUTH_PROXY_STORAGE_BACKEND=memory
# POSTGRES_MCP_OAUTH_PROXY_STORAGE_BACKEND=disk
# POSTGRES_MCP_OAUTH_PROXY_DISK_DIRECTORY=~/.fastmcp/postgres-mcp/oauth-proxy

# Production-recommended storage backend.
# POSTGRES_MCP_OAUTH_PROXY_STORAGE_BACKEND=valkey
# POSTGRES_MCP_OAUTH_PROXY_VALKEY_HOST=localhost
# POSTGRES_MCP_OAUTH_PROXY_VALKEY_PORT=6379
# POSTGRES_MCP_OAUTH_PROXY_VALKEY_DB=0
# Use true for managed/serverless Valkey endpoints that require TLS on 6379.
# POSTGRES_MCP_OAUTH_PROXY_VALKEY_USE_TLS=auto
# POSTGRES_MCP_OAUTH_PROXY_VALKEY_USERNAME=
# POSTGRES_MCP_OAUTH_PROXY_VALKEY_PASSWORD=
# POSTGRES_MCP_OAUTH_PROXY_VALKEY_KEY_PREFIX=postgres-mcp
# POSTGRES_MCP_OAUTH_PROXY_VALKEY_REQUEST_TIMEOUT_MS=5000
# POSTGRES_MCP_OAUTH_PROXY_VALKEY_CONNECTION_TIMEOUT_MS=10000

# Recommended when using disk or Valkey storage. Keep it stable across restarts.
# FASTMCP_SERVER_AUTH_GOOGLE_JWT_SIGNING_KEY=replace-with-a-long-random-secret

# =============================================================================
# Audit context headers
#
# x-airunner-* values are supplied by the HTTP MCP client per request, not by this
# .env file. They are logged as caller-asserted audit metadata:
#   x-airunner-identity        -> runner=
#   x-airunner-consumeraccount -> consumer=
#   x-airunner-job             -> job=
# =============================================================================
